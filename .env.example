# ── Database ──────────────────────────────────────────────────────────────────
# Local MongoDB or an Atlas connection string.
# Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/octagonetoys
MONGODB_URI=mongodb://localhost:27017/ecommerce

# ── Authentication ────────────────────────────────────────────────────────────
# Long random string used to sign admin/customer session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ── Site URL ─────────────────────────────────────────────────────────────────
# Canonical origin used by metadata, sitemap.xml and robots.txt.
# Use the real domain in production (https, no trailing slash).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Default admin (used by `npm run seed:admin`) ──────────────────────────────
# In production both values are required and the password must be >= 12 chars.
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=admin123

# ── Email notifications (optional) ────────────────────────────────────────────
# Without a key, emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Octagonetoys <orders@yourdomain.com>"

# ── Image uploads (optional) ─────────────────────────────────────────────────
# Without Cloudinary, uploads are written to public/uploads in development.
# Cloudinary is required in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Storefront contact details (optional, public) ────────────────────────────
NEXT_PUBLIC_STORE_EMAIL=hello@octagonetoys.com
NEXT_PUBLIC_STORE_PHONE="+92 300 0000000"
